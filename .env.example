# Copy this file to .env and fill it in:  cp .env.example .env
# Then check your setup with:             uv run arxiv-buddy check
#
# .env is gitignored. Never commit real credentials.
# Anything set in your real shell environment wins over this file.


# --- Who gets the email, and what they care about -------------------------

ARXIV_BUDDY_EMAIL=you@example.com

# Free text. This is the highest-leverage setting in the file — name subfields,
# methods, and the kind of paper you want, not just a broad field. Say so
# explicitly if you want classic papers as well as new preprints.
ARXIV_BUDDY_INTERESTS="Mechanistic interpretability of language models — sparse autoencoders, circuit analysis, feature steering. I also care about evaluation methodology for LLM agents. I value foundational papers as much as brand-new preprints."


# --- Claude ---------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-...

# Optional. Point the SDK at a different endpoint — needed on networks where
# api.anthropic.com isn't reachable (corporate VPN, internal gateway/proxy).
# Read directly by the Anthropic SDK. `arxiv-buddy check` prints which
# endpoint a run will use; `check --probe` actually connects to it.
# ANTHROPIC_BASE_URL=https://your-gateway.example/llm-api

# If the gateway wants a bearer token rather than an x-api-key, set this
# instead of ANTHROPIC_API_KEY (setting both is rejected by the API).
# ANTHROPIC_AUTH_TOKEN=...

# Optional. Defaults to claude-opus-5 (~2-5 cents/day).
# claude-sonnet-5 is cheaper, trading some selection quality.
# ARXIV_BUDDY_MODEL=claude-opus-5

# Optional. Candidate abstracts shown to Claude per run. Defaults to 60.
# ARXIV_BUDDY_POOL_SIZE=60


# --- SMTP -----------------------------------------------------------------
# Gmail:    smtp.gmail.com     / 587  (STARTTLS)
# Fastmail: smtp.fastmail.com  / 465  (set SMTP_USE_SSL=true)
# Resend:   smtp.resend.com    / 587  (username "resend", password = API key)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com

# For Gmail this is a 16-character App Password, NOT your account password:
#   https://myaccount.google.com/apppasswords  (requires 2-Step Verification)
# Note: changing your main Google password revokes every app password. The
# symptom is a 535-5.7.8 error in the cron log — generate a new one and
# update this value.
SMTP_PASSWORD=your-app-password

# Optional. SMTP_FROM defaults to SMTP_USERNAME.
# SMTP_FROM=you@gmail.com
# SMTP_FROM_NAME=arXiv Buddy

# Optional. SSL defaults to on for port 465; STARTTLS defaults to on otherwise.
# SMTP_USE_SSL=false
# SMTP_USE_STARTTLS=true


# --- Restricted networks (proxy / corporate TLS) --------------------------
# Only needed if your network intercepts TLS or requires a proxy.
#
# These are often set in a shell profile, which is enough interactively but
# NOT inherited by launchd or cron — a scheduled run gets an empty
# environment. Repeat anything the run depends on here, or the job fails
# (typically CERTIFICATE_VERIFY_FAILED when fetching from arXiv).
#
# SSL_CERT_FILE=/path/to/your-ca-bundle.crt
# REQUESTS_CA_BUNDLE=/path/to/your-ca-bundle.crt
# HTTPS_PROXY=http://proxy.example:8080


# --- Optional -------------------------------------------------------------

# Where the record of already-sent papers lives.
# Defaults to ~/.local/state/arxiv-buddy/state.json
# ARXIV_BUDDY_STATE=~/.local/state/arxiv-buddy/state.json
